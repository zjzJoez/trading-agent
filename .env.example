# Copy to .env and fill in. .env is gitignored.

# --- MoomooOpenD gateway ---
OPEND_HOST=127.0.0.1
OPEND_PORT=11111

# --- SEC EDGAR ---
# Required by SEC. Use a real email; they will block anonymous UAs.
# SEC blocks anonymous/fake UAs. Use a REAL email that you control — they
# email the address if they flag abuse.
SEC_UA_EMAIL=you@example.com

# --- Storage ---
# Leave empty to default to <repo>/data/trader.db
DB_PATH=

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Hyperliquid (hyperliquid-mcp) --- see docs/hyperliquid_mcp.md
# Every default below is the safe side. Market data needs none of this.
HL_NETWORK=testnet
# Signing key. Prefer an API (agent) wallet key: it can trade but never withdraw.
# With an agent key, HL_ACCOUNT_ADDRESS must be the MASTER account address.
HL_PRIVATE_KEY=
HL_ACCOUNT_ADDRESS=
# Default vault / sub-account to trade for (optional).
HL_VAULT_ADDRESS=
HL_READ_ONLY=false
# Mainnet writes need HL_NETWORK=mainnet AND this set to true.
HL_ALLOW_MAINNET_WRITES=false
# true = every write tool only previews (nothing is signed).
HL_DRY_RUN=false
# Write modules: trade (default) · transfer · withdraw · admin · advanced · or "none"
HL_WRITE_MODULES=trade
HL_MAX_ORDER_NOTIONAL_USD=1000
# Opening notional sent per UTC day, counted from the audit log across processes.
HL_MAX_DAILY_NOTIONAL_USD=10000
HL_MAX_LEVERAGE=10
HL_DEFAULT_SLIPPAGE=0.01
HL_MAX_SLIPPAGE=0.05
# Optional comma list, e.g. BTC,ETH,HYPE/USDC (reduce-only exits are always allowed)
HL_ALLOWED_COINS=
# Addresses that may receive funds or control: withdraw/send destinations, vaults
# you don't lead, builder codes, multi-sig signers. Your own account is always allowed.
HL_WITHDRAW_ALLOWLIST=
