# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Env & secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Generated per-machine — ship the .example / .template siblings, not the
# filled-in copies. `bash scripts/setup.sh` regenerates them after clone.
.claude/settings.json
.claude/settings.local.json
.mcp.json
deploy/launchd/*.plist
!deploy/launchd/*.plist.template

# Data — trader DB, filings cache, logs, hook audit. Keep sectors.csv
# (static GICS lookup) and .gitkeep. Using data/* instead of data/ so the
# !negations below can re-include specific files.
data/*
!data/.gitkeep
!data/sectors.csv

# Personal artifacts — not framework code, contain author's own trades / notes
scripts/generate_postmortem.py
HANDOFF*.md
*.HANDOFF.md

# Tooling artifacts dropped by Codex / claude-mem agent runs
AGENTS.md

# Local-only Phase 2 audit fallback file (`agent_events.fallback.jsonl` lives
# in $HOME, not the repo, but pin it just in case it ever gets dropped here)
agent_events.fallback.jsonl

# OS
.DS_Store

# Editor
.vscode/
.idea/
.claude/worktrees/
