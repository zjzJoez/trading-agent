[Unit]
Description=trading-agent candidate_entry on ticker %i
Documentation=https://github.com/joezz/trading-agent
After=network-online.target postgresql.service trading-agent-opend.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/trading-agent

ExecCondition=/bin/bash -c '! test -f /home/ubuntu/trading-agent/data/halt.flag'

EnvironmentFile=/home/ubuntu/trading-agent/.env
EnvironmentFile=/home/ubuntu/.env.postgres

ExecStart=/home/ubuntu/trading-agent/.venv/bin/python -m trading_agent.orchestrator --trigger=candidate_entry --ticker=%i

# 15-min hard cap (LLM chain w/ debate + risk council can take ~5-8 min)
TimeoutStartSec=900

StandardOutput=append:/var/log/trading-agent-brain.log
StandardError=append:/var/log/trading-agent-brain.err

NoNewPrivileges=true
PrivateTmp=true
