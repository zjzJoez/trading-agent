[Unit]
Description=trading-agent — daily EOD option-chain snapshot cache
Documentation=https://github.com/joezz/trading-agent
After=network-online.target postgresql.service trading-agent-opend.service
Wants=network-online.target
PartOf=trading-agent.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/trading-agent

# Skip silently when iOS halt killswitch is engaged
ExecCondition=/bin/bash -c '! test -f /home/ubuntu/trading-agent/data/halt.flag'

EnvironmentFile=/home/ubuntu/trading-agent/.env
EnvironmentFile=/home/ubuntu/.env.postgres

ExecStart=/home/ubuntu/trading-agent/.venv/bin/python -m trading_agent.jobs.cache_option_chains

# ~40 underlyings x (1 spot + 1 expiry list + up to 4 chain + 4 batch quote)
# calls; OpenD throttles quote requests, so allow up to 10 min.
TimeoutStartSec=600

StandardOutput=append:/var/log/trading-agent-chain-cache.log
StandardError=append:/var/log/trading-agent-chain-cache.err

NoNewPrivileges=true
PrivateTmp=true
