[Unit]
Description=trading-agent autonomous brain — oneshot %i trigger
Documentation=https://github.com/joezz/trading-agent
After=network-online.target postgresql.service trading-agent-opend.service
Wants=network-online.target
PartOf=trading-agent.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/trading-agent

# Skip silently when the iOS halt killswitch is engaged
ExecCondition=/bin/bash -c '! test -f /home/ubuntu/trading-agent/data/halt.flag'

EnvironmentFile=/home/ubuntu/trading-agent/.env
EnvironmentFile=/home/ubuntu/.env.postgres

ExecStart=/home/ubuntu/trading-agent/.venv/bin/python -m trading_agent.orchestrator --trigger=%i

# 15-min hard cap per run (intraday tick must complete before next tick fires)
TimeoutStartSec=900

StandardOutput=append:/var/log/trading-agent-brain.log
StandardError=append:/var/log/trading-agent-brain.err

# NoNewPrivileges must stay OFF here: this unit runs the orchestrator which
# fans out via `sudo systemctl start trading-agent-candidate-entry@TICKER`
# in premarket_nodes.dispatch_candidate_entry. NoNewPrivileges=true blocks
# sudo's setuid+setgid escalation, causing every dispatch to fail with
# `sudo: The "no new privileges" flag is set, which prevents sudo from
# running as root`. The candidate-entry@.service template can (and does)
# keep NoNewPrivileges=true since it never re-dispatches.
NoNewPrivileges=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
