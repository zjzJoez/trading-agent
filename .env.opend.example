# Moomoo OpenD (Linux) — Phase 2 EC2 deployment credentials
# Copy to .env.opend and fill in real values. .env.opend is gitignored.
# After editing: chmod 600 .env.opend
#
# These credentials are used by the systemd service on EC2 to start
# OpenD headlessly. We MD5 the password locally and pass to OpenD via
# command-line flag — the raw password never goes to disk on EC2.

# --- Account identity ---
# Moomoo splits phone logins into TWO parameters: area code + number.
# Examples (numbers are fictional — replace with your own):
#   Singapore phone +65 90000000   →  MOOMOO_AREA_CODE=+65   MOOMOO_LOGIN_ACCOUNT=90000000
#   China phone     +86 13900000000 →  MOOMOO_AREA_CODE=+86  MOOMOO_LOGIN_ACCOUNT=13900000000
#   US phone        +1 4155550100  →  MOOMOO_AREA_CODE=+1    MOOMOO_LOGIN_ACCOUNT=4155550100
# For email or numeric account-id logins, leave MOOMOO_AREA_CODE empty.
MOOMOO_AREA_CODE=
MOOMOO_LOGIN_ACCOUNT=

# Account login password — the password for logging into the Moomoo app.
# (NOT the 6-digit trading PIN — that's MOOMOO_TRADING_PWD below.)
# We MD5 this before passing to OpenD; raw value stays only in this file.
MOOMOO_LOGIN_PWD=

# --- Trading unlock (optional) ---
# 6-digit trading PIN. Only needed if your paper account requires
# unlock_trade() before placing orders. Phase 1 on Mac never called
# unlock_trade(), so this is likely NOT required for paper trading.
# Leave blank for now; we'll add it if OpenD rejects an order.
MOOMOO_TRADING_PWD=

# --- OpenD daemon ---
# TCP listen port (must match OPEND_PORT in main .env which is 11111)
MOOMOO_OPEND_PORT=11111

# Log level: DEBUG | INFO | WARN | ERROR
MOOMOO_OPEND_LOG_LEVEL=INFO
